# --- Сервис comment ---
PORT_COMMENT_SERVICE=
LEVEL_INFO_COMMENT_SERVICE=info

# --- Сервис user ---
PORT_USER_SERVICE=
LEVEL_INFO_USER_SERVICE=info

# --- Сервис poster ---
PORT_POSTER_SERVICE=
LEVEL_INFO_POSTER_SERVICE=info

# --- Postgres (поднимается в compose; сервисы пока на in-memory хранилищах) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
PORT_DATA_BASE=

# --- pgAdmin (веб-интерфейс для postgres) ---
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PORT_PGADMIN=

# Строка подключения к postgres (в docker задаётся в compose.yaml)
DB_URI=

# --- Swagger UI (интерактивная документация API) ---
PORT_SWAGGER=

# --- Сервис auth ---
PORT_AUTH_SERVICE=
LEVEL_INFO_AUTH_SERVICE=info

# --- MongoDB (хранилище токенов auth-сервиса) ---
# Порт, публикуемый наружу из compose (как PORT_DATA_BASE у postgres).
PORT_MONGO=
# Подключение для локального запуска (в docker задаётся в compose.yaml).
MONGO_URI=

# Время жизни токена auth-сервиса (go duration: 30m, 1h, 24h...)
AUTH_TOKEN_TTL=1h

PORT_BRIDGE_SERVICE=
LEVEL_INFO_BRIDGE_SERVICE=info
